<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AGUANTATE EL PARCHE STUDIO</title>
    <!-- Tailwind CSS para diseño responsivo y moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js para síntesis de instrumentos (Violín, Batería, Percusión, Guitarra) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Fuente Inter y JetBrains Mono para estética de estudio -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        studio: {
                            950: '#09090b',
                            900: '#121215',
                            800: '#1c1c21',
                            700: '#27272e',
                            accent: '#f59e0b', // Amber
                            emerald: '#10b981', // Emerald
                            violet: '#8b5cf6', // Violin
                            rose: '#f43f5e' // Record
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Personalización de barras de desplazamiento y deslizadores táctiles */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #121215;
        }
        ::-webkit-scrollbar-thumb {
            background: #27272e;
            border-radius: 3px;
        }
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }
        input[type="range"]::-webkit-slider-runnable-track {
            height: 6px;
            border-radius: 999px;
            background: #27272e;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #f59e0b;
            margin-top: -6px;
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
        }
        .rec-pulse {
            animation: pulse-red 1.5s infinite;
        }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(244, 63, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
        }
    </style>
</head>
<body class="bg-studio-950 text-zinc-100 font-sans antialiased selection:bg-amber-500 selection:text-zinc-950 pb-28">

    <!-- Notificación flotante (Reemplazo seguro de alert) -->
    <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-11/12 max-w-md pointer-events-none flex flex-col gap-2"></div>

    <!-- CABECERA DEL ESTUDIO -->
    <header class="sticky top-0 z-40 bg-studio-900/95 backdrop-blur-md border-b border-zinc-800 px-4 py-3 shadow-lg">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-md shadow-amber-500/20">
                    <svg class="w-5 h-5 text-zinc-950" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white leading-none">AGUANTATE EL PARCHE</h1>
                    <div class="flex items-center gap-1.5 mt-1">
                        <span class="text-[10px] font-mono uppercase tracking-widest text-amber-400 font-semibold">STUDIO MOBILE</span>
                        <span class="text-[10px] px-1.5 py-0.2 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-full font-medium">100% Gratis</span>
                    </div>
                </div>
            </div>
            
            <!-- Indicador de estado de audio -->
            <div id="audio-status-badge" class="text-xs font-mono px-2.5 py-1 rounded-lg bg-studio-800 border border-zinc-700 text-zinc-400 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-zinc-500" id="status-dot"></span>
                <span id="status-text">Sin pista</span>
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-3 sm:px-4 pt-4 space-y-4">

        <!-- SECCIÓN 1: ENTRADA DE AUDIO (GRABAR O IMPORTAR) -->
        <section class="bg-studio-900 border border-zinc-800 rounded-2xl p-4 shadow-xl">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    1. Captura o Importación de Audio
                </h2>
                <span id="rec-timer" class="font-mono text-xs text-rose-400 font-semibold hidden">00:00.0</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <!-- Botón Grabar Micrófono -->
                <button id="btn-record" class="flex items-center justify-center gap-2.5 bg-studio-800 hover:bg-zinc-700 active:scale-[0.98] border border-zinc-700 rounded-xl p-3.5 transition-all text-sm font-semibold text-white">
                    <span id="rec-icon" class="w-3.5 h-3.5 rounded-full bg-rose-500 inline-block"></span>
                    <span id="rec-label">Grabar con Micrófono</span>
                </button>

                <!-- Botón Importar Archivo -->
                <label class="flex items-center justify-center gap-2.5 bg-studio-800 hover:bg-zinc-700 active:scale-[0.98] border border-zinc-700 rounded-xl p-3.5 transition-all text-sm font-semibold text-white cursor-pointer">
                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    <span>Subir Audio (.mp3 / .wav)</span>
                    <input type="file" id="file-upload" accept="audio/*" class="hidden">
                </label>
            </div>

            <!-- Vúmetro / Nivel de entrada en vivo al grabar -->
            <div id="mic-meter-container" class="hidden mt-3 bg-studio-950 p-2.5 rounded-xl border border-zinc-800">
                <div class="flex justify-between text-[11px] text-zinc-400 mb-1">
                    <span>Nivel de entrada (Motorola Mic)</span>
                    <span class="text-rose-400 font-mono">GRABANDO...</span>
                </div>
                <div class="w-full h-2.5 bg-studio-800 rounded-full overflow-hidden">
                    <div id="mic-level-bar" class="h-full bg-gradient-to-r from-emerald-500 via-amber-400 to-rose-500 w-0 transition-all duration-75"></div>
                </div>
            </div>

            <!-- Información del archivo cargado -->
            <div id="loaded-file-info" class="hidden mt-3 pt-3 border-t border-zinc-800/80 flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-2 truncate max-w-[65%]">
                    <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-mono text-[10px]">MASTER BASE</span>
                    <span id="file-name-display" class="text-zinc-200 font-medium truncate">grabacion.wav</span>
                </div>
                <span id="file-duration-display" class="font-mono text-zinc-400">Duración: 00:00</span>
            </div>
        </section>

        <!-- SECCIÓN 2: DIVISIÓN DE PISTAS Y REMASTERIZACIÓN -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- División de Sonido (Separar Voz y Guitarra) -->
            <div class="bg-studio-900 border border-zinc-800 rounded-2xl p-4 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            2. División de Sonido
                        </h2>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700 font-mono">Offline DSP</span>
                    </div>
                    <p class="text-xs text-zinc-400 mb-3 leading-relaxed">
                        Separa tu toma única en dos pistas independientes usando filtrado espectral en tiempo real (Voz/Melodía y Guitarra/Cuerpo).
                    </p>
                </div>

                <div class="space-y-2">
                    <button id="btn-separate-stems" disabled class="w-full py-3 px-4 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-all bg-zinc-800 text-zinc-500 cursor-not-allowed border border-zinc-700/50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                        </svg>
                        <span id="stem-btn-text">Separar Pistas (Voz / Guitarra)</span>
                    </button>
                    <p id="stem-status-msg" class="text-[11px] text-center text-zinc-500">Cargá o grabá un audio primero</p>
                </div>
            </div>

            <!-- Remasterización Studio -->
            <div class="bg-studio-900 border border-zinc-800 rounded-2xl p-4 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                            3. Remasterización Studio
                        </h2>
                        <!-- Switch Toggle -->
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="toggle-remaster" class="sr-only peer" checked>
                            <div class="w-10 h-5 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500"></div>
                        </label>
                    </div>
                    <p class="text-xs text-zinc-400 mb-3 leading-relaxed">
                        Aplica compresión dinámica, realce de presencia vocal y calidez armónica antes de mezclar.
                    </p>
                </div>

                <div>
                    <label class="block text-[11px] text-zinc-400 mb-1 font-medium">Perfil de Masterización:</label>
                    <select id="remaster-preset" class="w-full bg-studio-800 border border-zinc-700 rounded-xl px-3 py-2.5 text-xs font-semibold text-white focus:outline-none focus:border-amber-500">
                        <option value="studio">Estudio Full (Equilibrado + Punch)</option>
                        <option value="vocal">Brillo Vocal (Claridad y Aire)</option>
                        <option value="warm">Cálido Acústico (Cuerpo de Guitarra)</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 4: LÍNEA DE TIEMPO MULTIPISTA Y AGREGADO POR TRAMOS -->
        <section class="bg-studio-900 border border-zinc-800 rounded-2xl p-4 shadow-xl">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-violet-500"></span>
                    4. Línea de Tiempo y Acompañamientos
                </h2>
                <div class="flex items-center gap-2 text-xs font-mono bg-studio-950 px-2.5 py-1 rounded-lg border border-zinc-800">
                    <span id="current-time-display" class="text-amber-400 font-bold">00:00.0</span>
                    <span class="text-zinc-600">/</span>
                    <span id="total-time-display" class="text-zinc-400">00:30.0</span>
                </div>
            </div>

            <!-- Visualizador de Onda + Línea de Tiempo Interactiva -->
            <div class="relative bg-studio-950 border border-zinc-800 rounded-xl p-2 mb-4 select-none overflow-hidden" id="timeline-wrapper">
                <!-- Canvas de Onda Principal -->
                <div class="relative h-20 w-full mb-2 cursor-pointer" id="waveform-container">
                    <canvas id="waveform-canvas" class="w-full h-full block rounded-lg"></canvas>
                    <!-- Cursor de reproducción (Playhead) -->
                    <div id="playhead" class="absolute top-0 bottom-0 w-0.5 bg-amber-400 shadow-[0_0_8px_#f59e0b] pointer-events-none left-0">
                        <div class="w-2.5 h-2.5 -ml-1 -mt-1 bg-amber-400 rotate-45"></div>
                    </div>
                </div>

                <!-- Pistas de Acompañamiento (Bloques por Tramo) -->
                <div class="space-y-1.5 border-t border-zinc-800/80 pt-2">
                    <div class="flex items-center justify-between text-[10px] text-zinc-500 px-1">
                        <span>TRAMOS DE INSTRUMENTOS AGREGADOS (Tocá un bloque para borrarlo)</span>
                        <span id="blocks-count">0 bloques</span>
                    </div>
                    <div id="timeline-tracks-container" class="relative min-h-[76px] bg-studio-900/60 rounded-lg p-1.5 space-y-1.5 border border-zinc-800/50">
                        <p id="empty-blocks-hint" class="text-xs text-zinc-600 text-center py-5">
                            Aún no agregaste instrumentos. Elegí un instrumento y un tramo abajo (ej. Violín del seg 5 al 15).
                        </p>
                    </div>
                </div>
            </div>

            <!-- Panel para Insertar Instrumento en un Tramo Específico -->
            <div class="bg-studio-800/70 border border-zinc-700/80 rounded-xl p-3.5 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        Insertar Acompañamiento por Tramo
                    </h3>
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] text-zinc-400">Tempo:</label>
                        <input type="number" id="bpm-input" value="100" min="60" max="180" class="w-14 bg-studio-950 border border-zinc-700 rounded-lg px-2 py-1 text-xs font-mono text-center text-amber-400 font-bold">
                        <span class="text-[10px] text-zinc-500">BPM</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- Selector de Instrumento -->
                    <div>
                        <label class="block text-[11px] text-zinc-400 mb-1">Instrumento a sumar:</label>
                        <select id="inst-select" class="w-full bg-studio-950 border border-zinc-700 rounded-xl px-3 py-2.5 text-xs font-semibold text-white focus:border-violet-500 focus:outline-none">
                            <option value="violin">🎻 Violín (Melodía expresiva / Cuerdas)</option>
                            <option value="bateria">🥁 Batería (Bombo, Redoblante y Hi-Hat)</option>
                            <option value="percusion">🪘 Percusión (Cajón, Bongó y Shaker)</option>
                            <option value="guitarra_extra">🎸 Guitarra Acompañamiento (Rasgueo)</option>
                        </select>
                    </div>

                    <!-- Progresión / Estilo Armónico -->
                    <div>
                        <label class="block text-[11px] text-zinc-400 mb-1">Base Armónica / Acordes:</label>
                        <select id="chord-select" class="w-full bg-studio-950 border border-zinc-700 rounded-xl px-3 py-2.5 text-xs font-semibold text-white focus:border-violet-500 focus:outline-none">
                            <option value="em_c_g_d">Em - C - G - D (Pop / Rock / Balada)</option>
                            <option value="am_f_c_g">Am - F - C - G (Épico / Melódico)</option>
                            <option value="c_g_am_f">C - G - Am - F (Acústico / Alegre)</option>
                            <option value="dm_bb_c_a">Dm - Bb - C - A (Folklore / Tensión)</option>
                        </select>
                    </div>
                </div>

                <!-- Selección de Tiempo Inicio y Fin -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 items-end">
                    <div>
                        <label class="block text-[11px] text-zinc-400 mb-1">Inicio (seg):</label>
                        <input type="number" id="start-sec-input" value="0" min="0" step="0.5" class="w-full bg-studio-950 border border-zinc-700 rounded-xl px-3 py-2 text-xs font-mono text-white">
                    </div>
                    <div>
                        <label class="block text-[11px] text-zinc-400 mb-1">Fin (seg):</label>
                        <input type="number" id="end-sec-input" value="10" min="1" step="0.5" class="w-full bg-studio-950 border border-zinc-700 rounded-xl px-3 py-2 text-xs font-mono text-white">
                    </div>
                    <button type="button" id="btn-set-from-cursor" class="bg-studio-950 hover:bg-zinc-800 border border-zinc-700 rounded-xl py-2 px-2.5 text-[11px] font-medium text-zinc-300 transition">
                        Desde cursor (+10s)
                    </button>
                    <button type="button" id="btn-set-full-song" class="bg-studio-950 hover:bg-zinc-800 border border-zinc-700 rounded-xl py-2 px-2.5 text-[11px] font-medium text-zinc-300 transition">
                        Todo el tema
                    </button>
                </div>

                <button id="btn-add-block" class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 active:scale-[0.99] text-white font-bold text-sm shadow
